# Copy to .env and replace both values with separate random passwords.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-different-long-random-app-password

# This Mac's LAN address (ipconfig getifaddr en1 for Wi-Fi).
CRM_LAN_IP=192.168.200.118

# Authentication (enable Feishu only after configuring app credentials and callback allowlist).
CRM_REQUIRE_LOGIN=1
CRM_FEISHU_ENABLED=0
CRM_FEISHU_APP_ID=
CRM_FEISHU_APP_SECRET=
CRM_FEISHU_REDIRECT_URI=http://127.0.0.1:8088/api/auth/feishu/callback

# Optional event/callback WebSocket; separate from OAuth redirect.
CRM_FEISHU_LONG_CONNECTION=0

# Native Feishu approval definitions belonging to this CRM's application.
# Keep empty until each template is published and application permissions are granted.
# A prepayment template is configured separately and never falls back to the sales template.
CRM_FEISHU_SALES_APPROVAL_CODE=
CRM_FEISHU_PREPAYMENT_APPROVAL_CODE=
# Receipt approval is independent; when configured, receipts are booked only after approval.
CRM_FEISHU_RECEIPT_APPROVAL_CODE=

# Private fixed-IP JST gateway. Never use a production token for sandbox tests.
CRM_JST_GATEWAY_URL=https://jstapi.emie.cn
CRM_JST_GATEWAY_TOKEN=
CRM_JST_ENV=sandbox

# Credit fulfillment: explicit noncash ERP tender; CRM receipts stay real.
# Enable only after confirming the ERP accounting treatment. Local connections remain read-only.
CRM_JST_CREDIT_ACCOUNTING_MODE=UNCONFIGURED
