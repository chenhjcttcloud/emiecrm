# Copy to .env and replace both values with separate random passwords.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-different-long-random-app-password

# This Mac's LAN address (ipconfig getifaddr en1 for Wi-Fi).
CRM_LAN_IP=192.168.200.118

# Authentication (enable Feishu only after configuring app credentials and callback allowlist).
CRM_REQUIRE_LOGIN=1
CRM_FEISHU_ENABLED=0
CRM_FEISHU_APP_ID=
CRM_FEISHU_APP_SECRET=
CRM_FEISHU_REDIRECT_URI=http://127.0.0.1:8088/api/auth/feishu/callback

# Optional event/callback WebSocket; separate from OAuth redirect.
CRM_FEISHU_LONG_CONNECTION=0
