GATEWAY_TOKEN=replace-with-random-private-token
JST_ENV=sandbox
JST_ALLOW_ORDER_UPLOAD=0
JST_ALLOW_ORDER_CHANGE=0
JST_APP_KEY=
JST_APP_SECRET=
JST_ACCESS_TOKEN=
# 自有商城自动续期（不支持服务商应用流程）；日期必须含时区。
JST_AUTO_REFRESH=0
JST_REFRESH_TOKEN=
JST_TOKEN_ISSUED_AT=
JST_TOKEN_EXPIRES_AT=
# 例如：2026-05-31T23:59:04+08:00 / 2026-11-27T23:59:04+08:00
# 持久目录须由容器 UID 10001 可写，备份必须包含此目录。
JST_TOKEN_DIRECTORY=/data/tokens
